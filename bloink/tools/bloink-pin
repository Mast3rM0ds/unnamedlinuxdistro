#!/bin/sh
# shame me for this one but it was sadly made with the use of a LLM
# real sorry but i aint doing all of these tools.
set -eu

cd "$(dirname "$0")/.."

if [ "$#" -gt 0 ]; then
    recipes="$*"
else
    recipes=$(find recipes -name package.lua | sort)
fi

pinned=0
skipped=0
failed=0

extract_urls() {
    python3 -c '
import re, sys
content = open(sys.argv[1]).read()
for m in re.findall(r"url\s*=\s*\"([^\"]+)\"", content):
    print(m)
' "$1"
}

splice_hash() {
    python3 -c '
import sys
path, digest = sys.argv[1], sys.argv[2]
with open(path) as f:
    content = f.read()
marker_str = "sha256 = \"PIN_ME\""
if marker_str in content:
    content = content.replace(marker_str, "sha256 = \"%s\"," % digest, 1)
    with open(path, "w") as f:
        f.write(content)
    print("spliced", file=sys.stderr)
else:
    print("no PIN_ME marker matched (already pinned or wording changed?)", file=sys.stderr)
' "$1" "$2"
}

for recipe in $recipes; do
    [ -f "$recipe" ] || { echo "bloink-pin: no such file: $recipe" >&2; continue; }

    if ! grep -q 'PIN_ME' "$recipe" 2>/dev/null; then
        skipped=$((skipped + 1))
        continue
    fi

    urls=$(extract_urls "$recipe")
    if [ -z "$urls" ]; then
        echo "bloink-pin: no source urls found in $recipe" >&2
        continue
    fi

    ok=1
    for url in $urls; do
        echo "bloink-pin: fetching $url" >&2
        tmp=$(mktemp)
        if ! wget -q --no-check-certificate --tries=3 -O "$tmp" "$url"; then
            echo "bloink-pin: FAILED to fetch $url (dead link? redirect changed?)" >&2
            rm -f "$tmp"
            ok=0
            continue
        fi
        hash=$(sha256sum "$tmp" | cut -d' ' -f1)
        rm -f "$tmp"
        echo "bloink-pin: $url -> $hash" >&2
        splice_hash "$recipe" "$hash"
    done

    if [ "$ok" = 1 ]; then
        pinned=$((pinned + 1))
    else
        failed=$((failed + 1))
    fi
done

echo "" >&2
echo "bloink-pin: $pinned pinned, $skipped already pinned, $failed failed" >&2
echo "bloink-pin: review the diff before trusting it -- dead/redirected links" >&2
echo "            can silently hash the wrong thing (e.g. a 404 page)." >&2
