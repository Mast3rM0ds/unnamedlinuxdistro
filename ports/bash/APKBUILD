pkgname=bash
pkgver=5.3
pkgrel=0
pkgdesc="the primary shell i guess"
url="https://www.gnu.org/software/bash/"
arch="all"
license="GPL-3.0-or-later"
depends="musl readline"
provides="/bin/sh"
subpackages="$pkgname-dbg $pkgname-doc"
source="https://ftp.gnu.org/gnu/bash/bash-$pkgver.tar.gz"
builddir="$srcdir/bash-$pkgver"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--bindir=/bin \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--with-curses \
		--disable-nls \
		--enable-readline \
		--without-bash-malloc \
		--with-installed-readline
	make
}

package() {
	make DESTDIR="$pkgdir" install	

	if [ -f "$pkgdir/usr/lib/pkgconfig/bash.pc" ]; then
		sed -i "s/^Version:.*/Version: $pkgver/" \
			"$pkgdir/usr/lib/pkgconfig/bash.pc"
	fi
}

sha512sums="
