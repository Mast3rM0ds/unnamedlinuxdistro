pkgname=gcc
pkgver=11.2.1
pkgrel=0
pkgdesc="gcc for compilation but prepackaged from musl.cc"
url="https://musl.cc"
arch="x86_64"
license="GPL-3.0-or-later"
options="!check !strip !tracedeps"
provides="
	so:libgcc_s.so.1=1
	so:libstdc++.so.6=6
	so:libatomic.so.1=1
	so:libgomp.so.1=1
	so:libitm.so.1=1
	so:libquadmath.so.0=0
	so:libssp.so.0=0
	so:libgfortran.so.5=5
	"
source="https://musl.cc/x86_64-linux-musl-native.tgz"
builddir="$srcdir/x86_64-linux-musl-native"

package() {
	local dest="$pkgdir/x86_64-linux-musl-native"
	mkdir -p "$dest"
	cp -a "$builddir"/bin "$builddir"/include "$builddir"/lib \
	      "$builddir"/libexec "$builddir"/x86_64-linux-musl "$dest/"

	mkdir -p "$pkgdir/usr/bin"
	for bin in "$dest"/bin/x86_64-linux-musl-*; do
		ln -sf "x86_64-linux-musl-native/bin/$(basename "$bin")" \
			"$pkgdir/usr/bin/$(basename "$bin")"
	done
}
sha512sums="
44d441ad9aa11a06feddf3daa4c9f53ad7d9ca37af1f5a61379aca07793703d179410cea723c1b7fca94c4de19a321228bdb3656bc5cbdb5e3bea8e2d6dac6c7  x86_64-linux-musl-native.tgz
"
