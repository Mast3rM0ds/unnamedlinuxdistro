pkgname=banner
pkgver=1.3.6
pkgrel=0
pkgdesc="a simple unix style banner program"
url="https://github.com/pronovic/banner"
arch="all"
license="none"
depends="musl"
subpackages="$pkgname-doc"
source="https://github.com/pronovic/banner/releases/download/BANNER_V$pkgver/banner-$pkgver.tar.gz"
builddir="$srcdir/banner-$pkgver"

build() {
	./configure --prefix=/usr --localstatedir=/var
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
