pkgname=alsa-lib
pkgver=1.2.15.3
pkgrel=0
pkgdesc="alsa(advanced linux sound architecture) library, note: doesnt work on deaf people"
url="https://www.alsa-project.org/"
arch="all"
license="LGPL-2.1-or-later"
depends="musl"
makedepends="linux-headers"
subpackages="$pkgname-dev"
source="https://www.alsa-project.org/files/pub/lib/alsa-lib-$pkgver.tar.bz2"
builddir="$srcdir/alsa-lib-$pkgver"

build() {
	./configure \
		--prefix=/usr \
		--disable-static
	make
}

package() {
	make DESTDIR="$pkgdir" install
}
sha512sums="
