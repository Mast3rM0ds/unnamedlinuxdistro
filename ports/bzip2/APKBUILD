pkgname=bzip2
pkgver=1.0.8
pkgrel=0
pkgdesc="a file compressor"
url="https://sourceware.org/bzip2/"
arch="all"
license="bzip2-1.0.6"
depends="musl"
subpackages="$pkgname-dev"
provides="so:libbz2.so.1=1.0.8"
source="https://sourceware.org/pub/bzip2/bzip2-$pkgver.tar.gz"
builddir="$srcdir/bzip2-$pkgver"

build() {
	make -f Makefile-libbz2_so
	make CC="cc" AR="ar" RANLIB="ranlib"
}

package() {
	make PREFIX="$pkgdir/usr" install
	install -Dm755 libbz2.so.1.0.8 "$pkgdir/usr/lib/libbz2.so.1.0.8"
	ln -sf libbz2.so.1.0.8 "$pkgdir/usr/lib/libbz2.so.1"
	ln -sf libbz2.so.1 "$pkgdir/usr/lib/libbz2.so"
}
sha512sums="
083f5e675d73f3233c7930ebe20425a533feedeaaa9d8cc86831312a6581cefbe6ed0d08d2fa89be81082f2a5abdabca8b3c080bf97218a1bd59dc118a30b9f3  bzip2-1.0.8.tar.gz
"
