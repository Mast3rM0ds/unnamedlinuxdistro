pkgname=alsa-utils
pkgver=1.2.16
pkgrel=0
pkgdesc="the utilities for alsa(advanced linux sound architecture)"
url="www.alsa-project.org/"
arch="all"
license="GPL-2.0-or-later"
depends="musl"
makedepends="make gcc alsa-lib-dev ncurses-dev"
subpackages="$pkgname-doc"
source="https://www.alsa-project.org/files/pub/utils/alsa-utils-$pkgver.tar.bz2"
builddir="$srcdir/alsa-utils-$pkgver"

build() {
	./configure --prefix=/usr
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

