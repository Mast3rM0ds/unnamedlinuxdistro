pkgname=sqlite
pkgver=3.46.1
pkgrel=0
pkgdesc="embedded sql database engine"
url="https://sqlite.org/"
arch="all"
license="blessing"
depends="musl"
subpackages="$pkgname-dev $pkgname-doc"
provides="so:libsqlite3.so.0=0"
source="https://sqlite.org/2024/sqlite-autoconf-3460100.tar.gz"
builddir="$srcdir/sqlite-autoconf-3460100"

build() {
	./configure --prefix=/usr
	make
}

package() {
	make DESTDIR="$pkgdir" install
}
