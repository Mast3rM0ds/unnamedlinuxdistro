pkgname=mpdecimal
pkgver=4.0.0
pkgrel=0
pkgdesc="arbitrary precision decimal arithmetic library"
url="https://www.bytereef.org/mpdecimal/"
arch="all"
license="BSD-2-Clause"
depends="musl"
subpackages="$pkgname-dev $pkgname-doc"
provides="so:libmpdec.so.4=4.0.0"
source="https://www.bytereef.org/software/mpdecimal/releases/mpdecimal-$pkgver.tar.gz"
builddir="$srcdir/mpdecimal-$pkgver"

build() {
	./configure --prefix=/usr
	make
}

package() {
	make DESTDIR="$pkgdir" install
}
