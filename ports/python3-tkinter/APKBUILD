fe9349ed49205cd974bea903e35ec9a308d3d489ec807da7c6178b05c8b47230cf6f7a0107a5818fa875e93bf49503ab1cd6ddea53788c7be73363794c22ef2c  musl-find_library.patch
f1ecb004871dc7e0c794eebe94ca1084b211924ecc97edc57f32a7c8df5d572e9ca6cdc45d6fc08009e480eb9a2c9f3d359d46989dc72c03679eb94ad97a2916  idle.desktop
"
