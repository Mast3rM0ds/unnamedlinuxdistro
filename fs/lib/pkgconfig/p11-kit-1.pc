prefix=/home/bloink/Work/unnamedlinuxdistro/fs
includedir=${prefix}/include
libdir=${prefix}/lib

p11_module_configs=/home/bloink/Work/unnamedlinuxdistro/fs/share/p11-kit/modules
p11_module_path=/home/bloink/Work/unnamedlinuxdistro/fs/lib/pkcs11
proxy_module=/home/bloink/Work/unnamedlinuxdistro/fs/lib/p11-kit-proxy.so
p11_system_config_modules=/home/bloink/Work/unnamedlinuxdistro/fs/etc/pkcs11/modules
p11_trust_paths=/home/bloink/Work/unnamedlinuxdistro/fs/etc/pki/anchors

Name: p11-kit
Description: Library and proxy module for properly loading and sharing PKCS#11 modules.
Version: 0.24.1
Libs: -L${libdir} -lp11-kit
Cflags: -I${includedir}/p11-kit-1
